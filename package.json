{
  "name": "book-reader",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "pdf-worker": "node ./scripts/copy-pdf-worker.mjs",
    "predev": "npm run pdf-worker",
    "prebuild": "npm run pdf-worker",
    "postinstall": "npm run pdf-worker",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "node --import tsx --test",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "check:access": "node --import tsx ./scripts/check-access-config.mts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@likecoin/epub-ts": "^0.7.2",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jszip": "3.10.1",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.127.0"
  }
}
