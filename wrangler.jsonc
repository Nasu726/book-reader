{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "book-reader",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  // nodejs_compat gives the Worker node:crypto, which the Access assertion
  // check needs.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Vite's output. Any path that is not a file is the app, which decides
    // the screen from the URL itself.
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Cloudflare Access authenticates before a request reaches this Worker and
    // forwards a signed assertion; these two values are what the assertion is
    // checked against. Neither is secret — the audience tag identifies the
    // application, it does not authorise anything on its own.
    //
    // The tag is regenerated whenever the Access application is deleted and
    // recreated. When sign-in loops back to the login page, compare this value
    // against the `kid` in the Access redirect before looking anywhere else.
    "CF_ACCESS_TEAM_DOMAIN": "https://nasu726.cloudflareaccess.com",
    "CF_ACCESS_AUD": "86696c7030019417f5c15a38f2be22d421d2b7cfafbb55c8a54269fc455778f5",
    // The vault: a GitHub repository and the folder in it the reader writes
    // to. Neither is secret. The token that lets the Worker write there is:
    // `npx wrangler secret put VAULT_TOKEN` (docs/HUMAN-TASKS.md H-12).
    "VAULT_REPO": "",
    "VAULT_DIR": "Reading"
  }
}
