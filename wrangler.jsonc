{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "book-reader",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  // nodejs_compat gives the Worker node:crypto, which the Access assertion
  // check needs. global_fetch_strictly_public makes fetch() to this app's own
  // hostname go back out through the edge, which is what OpenNext expects.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "book-reader",
      "database_id": "c0ed3894-0dbf-4de3-b151-2bf35396d577",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "book-reader-documents"
    }
  ],
  "vars": {
    // Filled in after the Access application exists; see docs/HUMAN-TASKS.md H-4.
    // While these are empty the deployed app has no way to sign anyone in: the
    // password login needs a SQLite file a Worker does not have.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "AI_PROVIDER": "openrouter",
    "AI_MODEL": "nvidia/nemotron-3-super-120b-a12b:free"
  }
  // OPENROUTER_API_KEY is a secret, not a var: `wrangler secret put`.
}
